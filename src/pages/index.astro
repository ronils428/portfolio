---
import '../styles/global.css';

const projects = [
  {
    title: 'Selected Project',
    description: 'A concise description of a project, case study, or experiment can live here.',
    href: '#',
  },
  {
    title: 'Another Build',
    description: 'Use this space to highlight outcomes, tools, or the problem you solved.',
    href: '#',
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="A minimal personal portfolio built with Astro and Tailwind CSS."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Portfolio</title>
  </head>
  <body class="min-h-screen bg-zinc-50 text-zinc-950 antialiased">
    <main class="mx-auto flex min-h-screen w-full max-w-5xl flex-col px-6 py-8 sm:px-8 lg:px-10">
      <header class="flex items-center justify-between border-b border-zinc-200 pb-6">
        <a class="text-sm font-semibold tracking-wide text-zinc-900" href="/">Portfolio</a>
        <nav class="flex items-center gap-5 text-sm text-zinc-600">
          <a class="transition hover:text-zinc-950" href="#work">Work</a>
          <a class="transition hover:text-zinc-950" href="#contact">Contact</a>
        </nav>
      </header>

      <section class="grid flex-1 items-center gap-12 py-16 sm:py-20 lg:grid-cols-[1.25fr_0.75fr]">
        <div>
          <p class="mb-5 text-sm font-medium uppercase tracking-[0.18em] text-teal-700">
            Personal Portfolio
          </p>
          <h1 class="max-w-3xl text-5xl font-semibold leading-none tracking-normal text-zinc-950 sm:text-6xl">
            Hi, I’m Ronil.
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-650">
            This is a minimal Astro and Tailwind CSS foundation for a personal portfolio.
            Replace this copy with your work, writing, projects, and contact details as the site grows.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              class="inline-flex min-h-11 items-center justify-center rounded-md bg-zinc-950 px-5 text-sm font-medium text-white transition hover:bg-zinc-800"
              href="#work"
            >
              View Work
            </a>
            <a
              class="inline-flex min-h-11 items-center justify-center rounded-md border border-zinc-300 px-5 text-sm font-medium text-zinc-900 transition hover:border-zinc-950"
              href="#contact"
            >
              Get in Touch
            </a>
          </div>
        </div>

        <aside class="border-l-2 border-teal-600 pl-6">
          <p class="text-sm font-medium text-zinc-500">Currently</p>
          <p class="mt-3 text-2xl font-semibold leading-snug text-zinc-900">
            Building a clean home for projects, writing, and experiments.
          </p>
        </aside>
      </section>

      <section id="work" class="border-t border-zinc-200 py-12">
        <div class="mb-6 flex items-end justify-between gap-6">
          <h2 class="text-2xl font-semibold text-zinc-950">Work</h2>
          <p class="max-w-md text-sm leading-6 text-zinc-600">
            Swap these placeholders for real projects when you are ready.
          </p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {
            projects.map((project) => (
              <a
                class="rounded-md border border-zinc-200 bg-white p-5 transition hover:border-teal-600 hover:shadow-sm"
                href={project.href}
              >
                <h3 class="text-lg font-semibold text-zinc-950">{project.title}</h3>
                <p class="mt-3 text-sm leading-6 text-zinc-600">{project.description}</p>
              </a>
            ))
          }
        </div>
      </section>

      <footer
        id="contact"
        class="flex flex-col gap-3 border-t border-zinc-200 py-8 text-sm text-zinc-600 sm:flex-row sm:items-center sm:justify-between"
      >
        <p>Built with Astro and Tailwind CSS.</p>
        <a class="font-medium text-zinc-900 transition hover:text-teal-700" href="mailto:hello@example.com">
          hello@example.com
        </a>
      </footer>
    </main>
  </body>
</html>
