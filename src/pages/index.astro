---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Ronil's portfolio is under construction. Check back soon." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Under Construction | Ronil</title>
  </head>
  <body class="min-h-screen bg-zinc-50 text-zinc-950 antialiased">
    <main class="mx-auto flex min-h-screen w-full max-w-xl flex-col items-center justify-center px-6 text-center">
      <div class="loader mb-10" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>

      <p class="mb-4 text-sm font-medium uppercase tracking-[0.18em] text-teal-700">
        Under Construction
      </p>
      <h1 class="text-4xl font-semibold leading-tight text-zinc-950 sm:text-5xl">
        Something new is on the way.
      </h1>
      <p class="mt-5 text-lg leading-8 text-zinc-650">
        I'm building my portfolio right now. Please check back later.
      </p>

      <div class="progress mt-10 h-1 w-48 overflow-hidden rounded-full bg-zinc-200" role="presentation">
        <div class="h-full w-1/3 rounded-full bg-teal-600"></div>
      </div>
    </main>
  </body>
</html>

<style>
  .loader {
    display: flex;
    gap: 0.6rem;
  }

  .loader span {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 9999px;
    background: var(--color-teal-600);
    animation: bounce 1.2s ease-in-out infinite;
  }

  .loader span:nth-child(2) {
    animation-delay: 0.15s;
  }

  .loader span:nth-child(3) {
    animation-delay: 0.3s;
  }

  .progress > div {
    animation: slide 1.8s ease-in-out infinite;
  }

  @keyframes bounce {
    0%, 80%, 100% { transform: translateY(0); opacity: 0.4; }
    40% { transform: translateY(-0.75rem); opacity: 1; }
  }

  @keyframes slide {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(300%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .loader span,
    .progress > div {
      animation: none;
    }
  }
</style>
